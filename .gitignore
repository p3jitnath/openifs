# Ignore the OpenIFS build/source/install directories and any log files
/source/
/build/
/build-gpu/
/install/
/*.log
/PROGRESS.md

# ecbundle (cloned at build time by openifs-bundle)
/ecbundle/

# Local forecast work and rebuilt runtimes, never part of the source tree
/.checks/
/.deps/
/runtime-*/
/experiments/
/openifs-expt/
/outputs/
/failed-runs/
/logs/
/openifs-data/climate.v020/
/openifs-data/ifsdata/
/openifs-data/rtables/
/openifs-data/*.tar.gz
/*.slurm
/core
/core.*

# Python
__pycache__/
*.pyc
.venv/
.build-venv/
*.egg-info/

# Local credentials
.cdsapirc
.cdsapi-key

# Fortran build artifacts
*.o
*.mod

# macOS
.DS_Store

# User-specific Docker config
scripts/bootstrap/docker/config/my_config.yml
